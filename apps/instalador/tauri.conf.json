{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Instalar o Bruma",
  "version": "0.1.0",
  "identifier": "dev.bruma.instalador",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bruma",
        "width": 560,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "label": "main",
        "decorations": false,
        "shadow": true
      }
    ]
  },
  "build": {
    "frontendDist": "ui"
  },
  "bundle": {
    "active": false,
    "icon": [
      "../desktop/icons/icon.ico"
    ]
  }
}
